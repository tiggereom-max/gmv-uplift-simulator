  policy: '단면→양면 자연전환',
  uplift_two_sided_won: s6Two,
  uplift_one_sided_won: s6Two / 2
});

segmentResults.sort((a, b) => b.uplift_one_sided_won - a.uplift_one_sided_won);

const totalTwo = segmentResults.reduce((a, b) => a + b.uplift_two_sided_won, 0);
const totalOne = segmentResults.reduce((a, b) => a + b.uplift_one_sided_won, 0);

const base = DATA.meta.q1_total_gmv_one;
const monthly = DATA.meta.q1_monthly_gmv_one;
const monthlyAlloc = Object.entries(monthly).map(([month, actual]) => {
  const uplift = base > 0 ? totalOne * (actual / base) : 0;
  return {
    month,
    actual_gmv_one_sided_won: actual,
    uplift_one_sided_won: uplift,
    projected_gmv_one_sided_won: actual + uplift
  };
});

