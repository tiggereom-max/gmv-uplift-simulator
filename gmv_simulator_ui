function segUpliftTwo(segNo) {
  const seg = DATA.segments[String(segNo)];
  const n = seg.n;
  const states = seg.states;
  let ev0 = 0;
  for (const st of states) ev0 += st.p * st.avg_v;

  let weighted = [];
  for (const st of states) {
    let w = st.p;
    if (segNo === 1) {
      if (st.kind === 'down') w *= (1 - downImp);
      if (st.kind === 'churn') w *= (1 - churnImp);
    } else {
      if (st.kind === 'up') w *= (1 + upImp);
      if (st.kind === 'down') w *= (1 - downImp);
      if (st.kind === 'churn') w *= (1 - churnImp);
    }
    weighted.push({ w, avg_v: st.avg_v });
  }

  const z = weighted.reduce((a, b) => a + b.w, 0);
  let ev1 = 0;
  for (const st of weighted) ev1 += (st.w / z) * st.avg_v;
  return (ev1 - ev0) * n;
}

function seg6UpliftTwo() {
  const s6 = DATA.segments['6'];
  const additionalUsers = s6.n * s6.p_conv * convImp;
  const delta = Math.max(s6.avg_conv - s6.avg_non, 0);
  return additionalUsers * delta;
}

const segmentResults = [];
