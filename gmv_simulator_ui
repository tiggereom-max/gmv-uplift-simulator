  const upliftTwo = segUpliftTwo(s);
  segmentResults.push({
    segment: `Seg${s}`,
    policy: s === 1 ? '하락/이탈 방어' : '상향+하락+이탈',
    uplift_two_sided_won: upliftTwo,
    uplift_one_sided_won: upliftTwo / 2
  });
}

const s6Two = seg6UpliftTwo();
